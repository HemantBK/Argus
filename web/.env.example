# Local development against the Firebase emulators (container argus-firebase-1) and a local API.
# Copy to .env.local. Nothing here is a secret: Firebase web config is public by design.
VITE_USE_EMULATORS=true
VITE_FIREBASE_PROJECT_ID=argus-local
VITE_FIREBASE_API_KEY=fake-api-key-for-emulator
VITE_FIREBASE_AUTH_DOMAIN=argus-local.firebaseapp.com
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_FIRESTORE_EMULATOR_HOST=localhost:8081
VITE_AUTH_EMULATOR_URL=http://localhost:9099
VITE_API_BASE=http://localhost:8080
# Whether the Start screen offers "Try your own clause" (src/env.ts). Leave it unset here: unset means open when
# VITE_USE_EMULATORS is "true" (local development, where you switch the local API's paste review on yourself) and
# closed in any other build. Set "true" or "false" to decide it; any other value stops the app at start-up. A
# production build must leave it unset or "false" unless the deployed API has paste review switched on, or the
# card invites a paste the API refuses.
# VITE_CUSTOM_CLAUSE_OPEN=false
