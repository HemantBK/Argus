# Copy to backend/.env (gitignored) and fill in. Local mode needs no Google Cloud account.
ARGUS_MODE=local
GOOGLE_CLOUD_PROJECT=argus-local
FIRESTORE_EMULATOR_HOST=localhost:8081
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# Local LLM provider: openrouter or aistudio. Cloud mode always uses Gemini on Vertex AI.
ARGUS_LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Model ids are pinned per provider in argus_api/config.py (PINNED_MODELS). Locally you may override them
# for an experiment; in cloud mode setting either variable is an error.
# ARGUS_AGENT_MODEL=google/gemini-3.8-flash
# ARGUS_MONITOR_MODEL=google/gemini-3.5-flash-lite

# Browser origins allowed to call the API (CORS), comma-separated. Required in cloud mode.
ARGUS_ALLOWED_ORIGINS=http://localhost:5173
